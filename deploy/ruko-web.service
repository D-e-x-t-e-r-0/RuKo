[Unit]
Description=Ruko web + API (Vite preview serving dist on 4173)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/ruko
Environment=NODE_ENV=production
Environment=PORT=4173
Environment=HOST=127.0.0.1
EnvironmentFile=-/opt/ruko/.env
ExecStartPre=/usr/bin/test -d /opt/ruko/dist
ExecStart=/usr/bin/npm run preview -- --port 4173 --host 127.0.0.1
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

# Health: systemd restarts on failure; nginx keeps serving static dist/ meanwhile
[Install]
WantedBy=multi-user.target
