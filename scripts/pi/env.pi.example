# Copy to /opt/ruko/.env on the Pi (or keep as .env). Never commit real keys.
# Minimal boot set — app runs keyless (deterministic fallback). Add keys to unlock AI/voice/bot.

# --- Web (Vite preview on Pi serves dist/ on 4173) ---
PORT=4173
HOST=127.0.0.1

# --- Optional AI reflection layer ---
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=  # legacy fallback slot still accepted

# --- Optional Sarvam voices (bulbul TTS / saarika STT) ---
SARVAM_API_KEY=

# --- Optional Telegram plug-in ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Public URL the bot calls back to (Pi via reverse proxy / tunnel):
# PUBLIC_BASE_URL=https://ruko.local
PUBLIC_BASE_URL=http://ruko.local

# --- Optional WhatsApp adapter (paid Business API, OFF by default) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Chat stats survive reboot when set:
# RUKO_SESSION_FILE=/var/lib/ruko/sessions.json
