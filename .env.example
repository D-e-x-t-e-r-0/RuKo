# Ruko environment variables (server-side only — never commit real keys)
#
# Copy to .env for local serverless emulation, or set these in the
# Vercel / Netlify project dashboard for deployed previews.

# Optional — Groq reflection layer (/api/ai)
# Get a key at https://console.groq.com (API Keys) and paste it here.
# The GEMINI_API_KEY slot is also accepted as a fallback.
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# Optional — Sarvam AI voices + translation (/api/sarvam)
# Get a key at https://dashboard.sarvam.ai and paste it here.
# Without it the app silently uses on-device Web Speech instead.
SARVAM_API_KEY=

# Optional — Telegram bot plug-in (/api/telegram webhook)
# 1) Create a bot with @BotFather and paste the token here.
# 2) Deploy, then run: npm run bot:set-webhook -- https://your-app.vercel.app
TELEGRAM_BOT_TOKEN=
# Shared secret Telegram echoes on every update (recommended).
TELEGRAM_WEBHOOK_SECRET=
