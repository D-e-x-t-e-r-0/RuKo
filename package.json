{
  "name": "ruko",
  "private": true,
  "version": "1.2.0-pi",
  "type": "module",
  "scripts": {
    "dev": "vite  --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pi": "node server/pi-server.mjs",
    "pi:audit": "node scripts/audit-pwa.mjs",
    "eval": "node eval/run.mjs",
    "test": "vitest run",
    "bot:set-webhook": "node scripts/set-webhook.mjs",
    "bot:dev": "node scripts/bot-poll.mjs",
    "bot:mock": "node scripts/mock-telegram-api.mjs",
    "dev:tunnel": "wait-on http://127.0.0.1:5173 && cloudflared tunnel --url http://127.0.0.1:5173",
    "dev:all": "concurrently \"npm run dev\" \"npm run bot:dev\" \"npm run dev:tunnel\""
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "dexie": "^4.0.10",
    "i18next": "^23.16.8",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.3",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.8",
    "wait-on": "^9.5.1"
  }
}
